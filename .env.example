# =============================================================================
# SAGE Environment Configuration
# Optimized for Raspberry Pi 4/5 (4GB+ RAM recommended)
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://sage:sage@postgres:5432/sage

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
# Recommended models for Raspberry Pi (sorted by resource usage):
# - tinyllama (1.1GB) - fastest, least accurate
# - phi (2.7GB) - good balance
# - mistral (4.1GB) - better quality, slower (8GB RAM recommended)
# - llama2 (3.8GB) - original, moderate speed
OLLAMA_MODEL=tinyllama

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# Application Settings
APP_NAME=SAGE
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Model Paths
MODELS_DIR=/app/models
DATA_DIR=/app/data

# Raspberry Pi CPU Settings
# Limit concurrent operations to prevent resource exhaustion
MAX_WORKERS=2
OMP_NUM_THREADS=4

# Whisper (STT) Settings
# Model sizes: tiny, base, small, medium, large
# For Raspberry Pi, use 'tiny' or 'base' for best performance
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8  # Use int8 for better performance on CPU

# TTS Settings (using Coqui TTS as alternative to Piper on ARM)
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_VOCODER=vocoder_models/en/ljspeech/hifigan_v2

# Embeddings
# Lightweight models recommended for Raspberry Pi:
# - all-MiniLM-L6-v2 (80MB) - fast, good quality
# - paraphrase-MiniLM-L3-v2 (61MB) - faster, smaller
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Cache Settings
ENABLE_MODEL_CACHE=True
CACHE_DIR=/app/data/cache
